# Copy to .env and fill in real values. Never commit the real .env file.
# Var names here match os.getenv(...) calls in app/config.py exactly (case-sensitive).

# --- LLM ---
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=
# Fast/cheap model used for grading and query rewriting
LLM_MODEL_FAST=gpt-4o-mini
# Smarter model used for answer generation
LLM_MODEL_SMART=gpt-4o-mini

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=advanced_rag_v1

# --- Postgres (user accounts) ---
# DATABASE_URL is built from these at runtime, not read directly.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=rag_metadata
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth ---
SECRET_KEY=your-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
